# Hardhat network RPC endpoints
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
BSC_TESTNET_RPC_URL=https://bsc-testnet.nodereal.io/v1/YOUR_KEY

# Private keys for deployment (0x-prefixed, no quotes)
DEPLOYER_PRIVATE_KEY=0xabc123...
# Optional per-network overrides
SEPOLIA_PRIVATE_KEY=0xabc123...
BSC_TESTNET_PRIVATE_KEY=0xabc123...
